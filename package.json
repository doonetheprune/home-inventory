{
  "name": "larder",
  "version": "0.4.1",
  "private": true,
  "description": "Self-hosted home inventory: stock, places, shopping lists and scanning. Runs on its own or with Home Assistant.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config src/web/vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:web && playwright test",
    "openapi": "tsx scripts/export-openapi.ts",
    "ha:services": "tsx scripts/export-ha-services.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^6.1.0",
    "minisearch": "^7.2.0",
    "mqtt": "5.16.0",
    "qrcode-generator": "2.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "aedes": "1.2.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
